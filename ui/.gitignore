# Dependencies
node_modules/

# Build outputs. `dist/` is the adapter-static output embedded by the peacock
# plugin (../src/render.rs). Ignore its contents but keep a tracked placeholder
# shell so a clean checkout compiles (rust-embed needs the folder) and serves
# something at `/`; `npm run build` overwrites it.
dist/*
!dist/index.html
build/
.svelte-kit/

# Generated files
*.tsbuildinfo
coverage/
playwright-report/

# openapi-ts: ./openapi.json is COMMITTED on purpose — it is the deterministic
# codegen input (refresh with `npm run gen:spec`, which wraps `orca openapi
# emit`). Committing it makes every API change a reviewable diff and lets CI
# regenerate + diff the client with no orca binary present. Pointing codegen at
# a live daemon instead is what let the client rot ~3 months behind the API.
# Only the generator's error logs are throwaway.
openapi-ts-error-*.log

# Env
.env.local
.env.*.local

# Legacy (Next.js remnant)
.next/

*storybook.log
storybook-static
